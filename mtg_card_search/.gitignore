# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
venv/
.venv/

# Environment / secrets
.env

# Card data (large, fetched by data_updater.py — see README)
cards/

# IDE
.idea/

# OS
.DS_Store

# Local debug output
failures

# data_updater.py operational state (log, run lock, sanity-check counts)
data_updater.log
*.lock
.dataset_counts.json

# Generated index artifacts (built by data_updater / the API fallback build).
# The source NDJSON is committed for the test fixture; the derived index is not.
*.marisa
*.offsets
*.index.json

# Block-compressed row store — derived, same as the index above. For the test
# fixture, `sample_cards.ndjson` stays the committed source of truth (plain
# text: reviewable, editable, greppable) and conftest.py regenerates this from
# it, so a libzstd difference can't dirty the tree with binary churn.
*.zndjson
